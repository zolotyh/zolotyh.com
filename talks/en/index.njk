---
title: Talks — zolotyh.com
description: Videos of Alexey Zolotyh's talks at conferences, meetups, and podcasts.
layout: base.njk
lang: en
alternateUrl: /talks/
---

<section class="talks">
  <h1>Talks</h1>
  <p class="talks-lead">50+ talks at conferences, meetups, and podcasts. Here are recordings of talks, plus slides for some of them.</p>

  {% set featuredTalks = talks.all | selectattr('featured') %}
  <section class="talks-featured" aria-labelledby="talks-featured-title">
    <h2 id="talks-featured-title" class="talks-section-title">Featured</h2>
    <div class="talks-grid talks-grid--featured">
      {% for talk in featuredTalks %}
        <article class="talks-card talks-card--featured" data-tags="{{ talk.tags | join(',') }}">
          <div class="talks-media" data-embed-url="{{ talk.embedUrl }}" data-title="{{ talk.title }}">
            <img class="talks-thumbnail" src="https://img.youtube.com/vi/{{ talk.videoId }}/maxresdefault.jpg" alt="{{ talk.title }}" loading="lazy" data-thumbnail-fallback="https://img.youtube.com/vi/{{ talk.videoId }}/hqdefault.jpg">
            <button class="talks-play" type="button" aria-label="Play: {{ talk.title }}">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            </button>
          </div>
          <div class="talks-card-body">
            <p class="talks-card-meta">
              <time class="talks-card-year" datetime="{{ talk.year }}">{{ talk.year }}</time>
              <span class="talks-card-conf">{{ talk.conference }}</span>
              <span class="talks-card-lang">{{ talk.lang | upper }}</span>
            </p>
            <h3 class="talks-card-title">
              <a href="{{ talk.video }}" target="_blank" rel="noopener noreferrer">{{ talk.title }}</a>
            </h3>
            {% if talk.tags %}
              <p class="talks-tags">
                {% for tag in talk.tags %}
                  <span class="talks-tag">{{ tag }}</span>
                {% endfor %}
              </p>
            {% endif %}
            {% if talk.slidesUrl %}
              <p class="talks-slides">
                <a href="{{ talk.slidesUrl }}" target="_blank" rel="noopener noreferrer">Slides</a>
              </p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  {% set allTags = [] %}
  {% for talk in talks.all %}
    {% for tag in talk.tags %}
      {% if tag not in allTags %}
        {% set _ = allTags.push(tag) %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  <div class="talks-filters" role="group" aria-label="Filter by topic">
    <button class="talks-filter talks-filter--active" type="button" data-filter="all">All</button>
    {% for tag in allTags | sort %}
      <button class="talks-filter" type="button" data-filter="{{ tag }}">{{ tag }}</button>
    {% endfor %}
  </div>

  {% for year, yearTalks in talks.all | groupbyYearDesc %}
    <section class="talks-year" data-year="{{ year }}" aria-labelledby="talks-year-{{ year }}">
      <h2 id="talks-year-{{ year }}" class="talks-year-title"><time datetime="{{ year }}">{{ year }}</time></h2>
      <div class="talks-grid">
        {% for talk in yearTalks %}
          <article class="talks-card" data-tags="{{ talk.tags | join(',') }}">
            <div class="talks-media" data-embed-url="{{ talk.embedUrl }}" data-title="{{ talk.title }}">
              <img class="talks-thumbnail" src="https://img.youtube.com/vi/{{ talk.videoId }}/maxresdefault.jpg" alt="{{ talk.title }}" loading="lazy" data-thumbnail-fallback="https://img.youtube.com/vi/{{ talk.videoId }}/hqdefault.jpg">
              <button class="talks-play" type="button" aria-label="Play: {{ talk.title }}">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
              </button>
            </div>
            <div class="talks-card-body">
              <p class="talks-card-meta">
                <time class="talks-card-year" datetime="{{ talk.year }}">{{ talk.year }}</time>
                <span class="talks-card-conf">{{ talk.conference }}</span>
              </p>
              <h3 class="talks-card-title">
                <a href="{{ talk.video }}" target="_blank" rel="noopener noreferrer">{{ talk.title }}</a>
              </h3>
              {% if talk.tags %}
                <p class="talks-tags">
                  {% for tag in talk.tags %}
                    <span class="talks-tag">{{ tag }}</span>
                  {% endfor %}
                </p>
              {% endif %}
              {% if talk.slidesUrl %}
                <p class="talks-slides">
                  <a href="{{ talk.slidesUrl }}" target="_blank" rel="noopener noreferrer">Slides</a>
                </p>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    </section>
  {% endfor %}
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": [
    {% for talk in talks.all %}
    {
      "@type": "VideoObject",
      "name": {{ talk.title | dump | safe }},
      "description": {{ talk.title | dump | safe }},
      "thumbnailUrl": "https://img.youtube.com/vi/{{ talk.videoId }}/hqdefault.jpg",
      "contentUrl": "{{ talk.video }}",
      "embedUrl": "{{ talk.embedUrl }}",
      "uploadDate": "{{ talk.year }}-01-01"
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>

<script>
(function () {
  const talks = document.querySelector('.talks');
  if (!talks) return;

  talks.addEventListener('error', function (event) {
    const img = event.target;
    if (!img.classList.contains('talks-thumbnail')) return;
    const fallback = img.getAttribute('data-thumbnail-fallback');
    if (fallback && img.src !== fallback) {
      img.src = fallback;
    }
  }, true);

  talks.addEventListener('click', function (event) {
    const playButton = event.target.closest('.talks-play');
    if (!playButton) return;

    const media = playButton.closest('.talks-media');
    const embedUrl = media.getAttribute('data-embed-url');
    const title = media.getAttribute('data-title');
    if (!embedUrl) return;

    const region = document.createElement('div');
    region.setAttribute('role', 'region');
    region.setAttribute('aria-label', 'Video: ' + title);
    region.setAttribute('tabindex', '-1');
    region.style.position = 'absolute';
    region.style.inset = '0';
    region.style.width = '100%';
    region.style.height = '100%';
    region.style.outline = 'none';

    const iframe = document.createElement('iframe');
    const url = new URL(embedUrl);
    url.searchParams.set('autoplay', '1');
    iframe.setAttribute('src', url.toString());
    iframe.setAttribute('title', title);
    iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
    iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
    iframe.setAttribute('allowfullscreen', '');
    iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-presentation');
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    iframe.style.border = '0';

    region.appendChild(iframe);
    media.innerHTML = '';
    media.appendChild(region);
    region.focus();
  });

  const filterButtons = talks.querySelectorAll('.talks-filter');
  const cards = talks.querySelectorAll('.talks-card');
  const yearSections = talks.querySelectorAll('.talks-year');

  filterButtons.forEach(function (button) {
    button.addEventListener('click', function () {
      const filter = button.getAttribute('data-filter');

      filterButtons.forEach(function (btn) {
        btn.classList.toggle('talks-filter--active', btn === button);
      });

      cards.forEach(function (card) {
        const tags = card.getAttribute('data-tags') || '';
        const shouldShow = filter === 'all' || tags.split(',').includes(filter);
        card.hidden = !shouldShow;
      });

      yearSections.forEach(function (section) {
        const visibleCards = section.querySelectorAll('.talks-card:not([hidden])');
        section.hidden = visibleCards.length === 0;
      });
    });
  });
})();
</script>
