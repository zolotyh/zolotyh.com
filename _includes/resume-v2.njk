---
layout: base.njk
---

<article class="resume">
  <header class="resume-hero">
    <div class="resume-actions no-print">
      <button id="resume-pdf" type="button" class="no-print icon-button" aria-label="{% if lang == 'ru' %}Сохранить PDF{% else %}Save PDF{% endif %}">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
      </button>
    </div>
    <h1 class="resume-name">{{ name }}</h1>
    <p class="resume-role">{{ role }}</p>
    {% if updated %}
      <p class="resume-update"><time datetime="{{ updatedDate or '2026-07-14' }}">{{ updated }}</time></p>
    {% endif %}
  </header>

  <div class="resume-grid">
    <aside class="resume-sidebar">
      <section class="resume-section">
        <h3 class="resume-section-label">{{ labels.contact or 'Contact' }}</h3>
        <ul class="contact-list">
          {% for contact in contacts %}
            <li>
              {% if contact.url %}
                <a href="{{ contact.url }}">{{ contact.label }}</a>
              {% else %}
                <span>{{ contact.label }}</span>
              {% endif %}
            </li>
          {% endfor %}
          <li><span>{{ location }}</span></li>
        </ul>
      </section>

      <section class="resume-section">
        <h3 class="resume-section-label">{{ labels.social or 'Social media' }}</h3>
        {% include "social-links.njk" %}
      </section>

      <section class="resume-section">
        <h2 class="resume-section-label">{{ labels.skills or 'Skills' }}</h2>
        {% if skillCategories %}
          {% for group in skillCategories %}
            <div class="skill-category">
              <h3 class="skill-category-label">{{ group.category }}</h3>
              <ul class="skill-list">
                {% for skill in group.items %}
                  <li>{{ skill }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endfor %}
        {% else %}
          <ul class="skill-list">
            {% for skill in skills %}
              <li>{{ skill }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </section>

      <section class="resume-section">
        <h3 class="resume-section-label">{{ labels.languages or 'Languages' }}</h3>
        <ul class="contact-list">
          {% for language in languages %}
            <li><span>{{ language }}</span></li>
          {% endfor %}
        </ul>
      </section>

      <section class="resume-section">
        <h3 class="resume-section-label">{{ labels.education or 'Education' }}</h3>
        <ul class="contact-list">
          {% for edu in education %}
            <li><span>{{ edu }}</span></li>
          {% endfor %}
        </ul>
      </section>
    </aside>

    <div class="resume-main">
      {{ content | safe }}
    </div>
  </div>
</article>
