<!DOCTYPE html>
<html lang="{{ lang or 'ru' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://img.youtube.com">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description | default(title) }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description | default(title) }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ site.image }}">
  <meta property="og:locale" content="{% if lang == 'en' %}en_US{% else %}ru_RU{% endif %}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description | default(title) }}">
  <meta name="twitter:image" content="{{ site.url }}{{ site.image }}">
  {% if alternateUrl %}
  <link rel="alternate" hreflang="{% if lang == 'en' %}en{% else %}ru{% endif %}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{% if lang == 'en' %}ru{% else %}en{% endif %}" href="{{ site.url }}{{ alternateUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ page.url }}">
  {% endif %}
  {{ seo | safe }}
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="128x128" href="/assets/favicon.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <script>
    (function () {
      try {
        const stored = localStorage.getItem('theme');
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', stored || system);
      } catch (e) {}
    })();
  </script>
  <link rel="preload" href="/assets/fonts/Manrope-VF-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="preload" href="/assets/fonts/Manrope-VF-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="preload" href="/assets/fonts/Spectral-Regular-cyrillic.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="preload" href="/assets/fonts/Spectral-Regular-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous">
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
</head>
<body>
  <a class="skip-link" href="#main">{% if lang == 'en' %}Skip to content{% else %}Перейти к содержимому{% endif %}</a>
  <header class="site-header no-print">
    <a href="{% if lang == 'en' %}/en/{% else %}/{% endif %}" class="site-logo">zolotyh</a>
    <div class="site-header-right">
      <nav class="site-nav" aria-label="{% if lang == 'en' %}Main navigation{% else %}Основная навигация{% endif %}">
        {% if lang == 'en' %}
          <a href="/en/" {% if page.url == '/en/' %}aria-current="page"{% endif %}>Home</a>
          <a href="/resume/en/" {% if page.url == '/resume/en/' %}aria-current="page"{% endif %}>Resume</a>
          <a href="/talks/en/" {% if page.url == '/talks/en/' %}aria-current="page"{% endif %}>Talks</a>
        {% else %}
          <a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}>Главная</a>
          <a href="/resume/" {% if page.url == '/resume/' %}aria-current="page"{% endif %}>Резюме</a>
          <a href="/talks/" {% if page.url == '/talks/' %}aria-current="page"{% endif %}>Доклады</a>
        {% endif %}
      </nav>
      <div class="lang-switcher" aria-label="{% if lang == 'en' %}Language{% else %}Выбор языка{% endif %}">
        {% if lang == 'en' %}
          <a href="{{ alternateUrl }}" class="lang-switcher__link" lang="ru" hreflang="ru">RU</a>
          <span class="lang-switcher__divider" aria-hidden="true">/</span>
          <span class="lang-switcher__current" aria-current="true">EN</span>
        {% else %}
          <span class="lang-switcher__current" aria-current="true">RU</span>
          <span class="lang-switcher__divider" aria-hidden="true">/</span>
          <a href="{{ alternateUrl }}" class="lang-switcher__link" lang="en" hreflang="en">EN</a>
        {% endif %}
      </div>
      <div class="site-utils">
        <button id="theme-toggle" type="button" class="no-print icon-button" aria-label="{% if lang == 'en' %}Toggle theme{% else %}Переключить тему{% endif %}">
          <span class="theme-icon theme-icon--light" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
          </span>
          <span class="theme-icon theme-icon--dark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </span>
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    {% block content %}
      {{ content | safe }}
    {% endblock %}
  </main>
  <script>
    (function () {
      const toggle = document.getElementById('theme-toggle');
      const lightIcon = toggle.querySelector('.theme-icon--light');
      const darkIcon = toggle.querySelector('.theme-icon--dark');

      function updateIcon() {
        const current = document.documentElement.getAttribute('data-theme');
        const isEn = document.documentElement.getAttribute('lang') === 'en';
        if (current === 'dark') {
          lightIcon.classList.add('theme-icon--active');
          darkIcon.classList.remove('theme-icon--active');
          toggle.setAttribute('aria-label', isEn ? 'Switch to light theme' : 'Переключить на светлую тему');
        } else {
          darkIcon.classList.add('theme-icon--active');
          lightIcon.classList.remove('theme-icon--active');
          toggle.setAttribute('aria-label', isEn ? 'Switch to dark theme' : 'Переключить на тёмную тему');
        }
      }

      toggle.addEventListener('click', function () {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        updateIcon();
      });

      updateIcon();
    })();
  </script>
  <script>
    (function () {
      const pdfButton = document.getElementById('resume-pdf');
      if (pdfButton) {
        pdfButton.addEventListener('click', function () {
          window.print();
        });
      }
    })();
  </script>
  <footer class="site-footer no-print">
    <div class="site-footer-content">
      <p>&copy; 2026 Alexey Zolotyh. <a href="mailto:info@zolotyh.com">info@zolotyh.com</a></p>
      {% include "social-links.njk" %}
    </div>
  </footer>
</body>
</html>
