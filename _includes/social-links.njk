{% set links = [
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/alexzolotyh/', icon: 'linkedin' },
  { name: 'Habr', url: 'https://habr.com/ru/users/zolotyh/', icon: 'habr' },
  { name: 'X', url: 'https://x.com/zolotyh', icon: 'x' },
  { name: 'VK', url: 'https://vk.com/aazolotyh', icon: 'vk' },
  { name: 'Facebook', url: 'https://www.facebook.com/alexey.zolotyh', icon: 'facebook' },
  { name: 'Instagram', url: 'https://www.instagram.com/alexzolotyh/', icon: 'instagram' }
] %}

<nav class="social-links" aria-label="{% if lang == 'en' %}Social media{% else %}Социальные сети{% endif %}">
  {% for link in links %}
    <a href="{{ link.url }}" class="social-link" target="_blank" rel="noopener noreferrer me" aria-label="{{ link.name }}">
